# Applied on top of vendor/dify/docker/.env.example by scripts/bootstrap.sh
# Lab-tuned for a constrained sandbox + enterprise-style binding.

# Uncommon host port (maps nginx 80 inside the container)
EXPOSE_NGINX_PORT=3847
EXPOSE_NGINX_SSL_PORT=38443

# Bind plugin debug port only via override; keep default closed in lab overlay intent
EXPOSE_PLUGIN_DEBUGGING_HOST=127.0.0.1
EXPOSE_PLUGIN_DEBUGGING_PORT=15003

# URLs trainees / builders hit
CONSOLE_API_URL=http://localhost:3847
CONSOLE_WEB_URL=http://localhost:3847
SERVICE_API_URL=http://localhost:3847
APP_API_URL=http://localhost:3847
APP_WEB_URL=http://localhost:3847
FILES_URL=http://localhost:3847
TRIGGER_URL=http://localhost:3847
ENDPOINT_URL_TEMPLATE=http://localhost:3847/e/{hook_id}
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3847

# Leaner workers for lab RAM
SERVER_WORKER_AMOUNT=1
CELERY_WORKER_AMOUNT=1
API_WEBSOCKET_WORKER_AMOUNT=1

# Drop collaboration profile to save a container (api_websocket)
# Keep postgresql + weaviate
COMPOSE_PROFILES=weaviate,postgresql
ENABLE_COLLABORATION_MODE=false

# Self-hosted identity
DEPLOY_ENV=PRODUCTION
EDITION=SELF_HOSTED

# Marketplace needed for OpenRouter plugin install (outbound HTTPS)
MARKETPLACE_ENABLED=true

# Lab secrets — rotate before any shared/enterprise use
SECRET_KEY=lab-dify-secret-rotate-before-prod
DB_PASSWORD=lab_dify_pg_change_me
REDIS_PASSWORD=lab_dify_redis_change_me
CELERY_BROKER_URL=redis://:lab_dify_redis_change_me@redis:6379/1
WEAVIATE_API_KEY=lab-weaviate-key-change-me
WEAVIATE_AUTHENTICATION_APIKEY_ALLOWED_KEYS=lab-weaviate-key-change-me
SANDBOX_API_KEY=lab-sandbox-key
CODE_EXECUTION_API_KEY=lab-sandbox-key
PLUGIN_DAEMON_KEY=lab-plugin-daemon-key-change-me-32chars!!
PLUGIN_DIFY_INNER_API_KEY=lab-plugin-inner-api-key-change-me!!
DIFY_AGENT_API_TOKEN=lab-agent-token-change-me
DIFY_AGENT_SERVER_SECRET_KEY=labAgentServerSecretKeyChangeMe32b
