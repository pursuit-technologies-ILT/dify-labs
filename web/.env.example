# Walkthrough (web/) — copy to .env.local. Never commit secrets.
# COLLAB_PASSWORD / DEMO_PASSWORD live only here and on Vercel env.

COLLAB_PASSWORD=
COLLAB_SESSION_SECRET=

# Public Dify Studio origin after a tunnel is up (HTTPS). Empty = no remote canvas.
NEXT_PUBLIC_DIFY_STUDIO_URL=
NEXT_PUBLIC_DIFY_CANVAS_PATH=/app/2615218e-4cd3-4f56-bad4-866a62c93627/workflow
NEXT_PUBLIC_DIFY_ADMIN_EMAIL=lab-admin@example.com
NEXT_PUBLIC_COLLAB_EXPIRES=2026-10-06
