# =============================================================================
# LAB KEYS — copy to .env and fill in. This is the only file you need to edit.
#   cp .env.example .env
# Then: ./scripts/up.sh
# =============================================================================

# --- Required for model calls (builders + trainees) ---
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional: direct OpenAI fallback (leave blank if using OpenRouter only) ---
OPENAI_API_KEY=

# --- Lab admin bootstrap (Dify first-install password hint; set in UI on first visit) ---
# Leave blank to set interactively at http://localhost:3847/install
DIFY_INIT_PASSWORD=

# --- Temporary collaborator walkthrough gate (never commit the real value) ---
# Used by web/ login and ./scripts/set-dify-admin-password.sh. Also set on Vercel.
COLLAB_PASSWORD=

# --- Open WebUI first admin (created on first visit in the UI) ---
# No key needed here; create the account in the browser.

# --- Lab ports (uncommon defaults to avoid collisions) ---
DIFY_HOST_PORT=3847
OPEN_WEBUI_HOST_PORT=3848

# --- Stack mode ---
# dify  = Dify only (default; matches portal-BFF student path)
# full  = Dify + Open WebUI (optional ChatGPT-style demo front end)
# webui = Open WebUI only (light chat UI smoke test)
LAB_MODE=dify

# --- Generated locally (scripts can set this) ---
WEBUI_SECRET_KEY=
