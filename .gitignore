# Secrets — never commit real keys or local credentials
.env
.env.*
!.env.example
lab/.env
lab-creds.env
**/credentials*.json
**/secrets*.yaml
**/secrets*.yml

# Ephemeral key dumps / cookie jars
*.pem
*.key
!vendor/**/*.key
/tmp/
or.key
*.cookie
*-cookies.txt

# Dify runtime (vendored compose state)
vendor/dify/docker/.env
vendor/dify/docker/volumes/
vendor/dify/docker/docker-compose.override.yml
vendor/dify/docker/nginx/conf.d/default.conf

# Runtime / local state
*.log
/swapfile
agent-tools/
.playwright/
.cache/

# Screenshot bulk runs (regenerate with ./scripts/screenshots/capture-lab.sh)
artifacts/screenshots/
# Keep curated worksheet mirrors under docs/lab-materials/screenshots/ tracked when small

# Vibium local install under tools/vibium (commit sources + lockfile; not node_modules)
tools/vibium/node_modules/

# Next.js companion (web/.gitignore also covers .next / node_modules)
web/node_modules/
web/.next/
web/.vercel/
.vercel/

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp
*~
